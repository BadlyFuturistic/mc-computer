#!/usr/bin/env python3
"""mcblock — what block is actually there.

  mcblock <x> <y> <z> [--dimension <dim>]
  mcblock survey <x1> <y1> <z1> <x2> <y2> <z2> [--top <n>] [--match <text>]
  mcblock find <text> <x1> <y1> <z1> <x2> <y2> <z2> [--limit <n>]
  mcblock check <x1> <y1> <z1> <x2> <y2> <z2> [--text] [--margin <n>]
  mcblock dimensions

  mcblock 950 66 293                       -> waystones:andesite_waystone
  mcblock survey 300 60 200 340 80 240     what a region is made of
  mcblock find pipez 300 50 200 340 70 240 where a block actually is
  mcblock check 300 60 200 340 80 240      counts, surfaces, voids and anything foreign
  mcblock 950 66 293 --verify              cross-check one read against the server

  --dimension <dim>  default minecraft:overworld
  --no-flush         skip the save; faster, but misses changes since the last save
  --verify           confirm the read against RCON before trusting it
  --text             human summary from `check` instead of JSON
  --margin <n>       how far outside the box `check` samples terrain (default 8)

RCON cannot answer this question. Its only block read is `execute if block <id>`,
which tests an id you already guessed and replies yes or no — so a wrong guess and an
empty space look identical. That is what let a mistyped block id run a hundred fills
and change nothing.

Reads come from the region files, which hold the last save. `save-all flush` runs
first so the answer is current; it costs about a third of a second, once, however many
blocks are read after it.
"""
import itertools
import json
import sys
import time

sys.path.insert(0, "/opt/mc")
import region  # noqa: E402
from mcrcon import RconError  # noqa: E402


def take(args, flag, cast=str, default=None):
    if flag in args:
        i = args.index(flag)
        value = cast(args[i + 1])
        del args[i:i + 2]
        return value
    return default


def coords(values, count):
    try:
        return [int(v) for v in values[:count]]
    except (ValueError, IndexError):
        sys.exit("coordinates must be whole numbers")


def report_point(reader, x, y, z, verify):
    block = reader.block(x, y, z)
    if block is None:
        print(f"{x} {y} {z}: nothing stored — that chunk has never been generated, "
              f"or has never been saved")
        return 1
    print(f"{x} {y} {z}: {block}")
    if verify:
        agree, _, verdict = reader.verify(x, y, z)
        print(f"  verified against the server: {'agrees' if agree else 'DISAGREES'}"
              + (f" ({verdict})" if not agree else ""))
        if not agree:
            print("  the reader is out of step with this world version — "
                  "use RCON until it is fixed", file=sys.stderr)
            return 2
    return 0


def report_survey(reader, box, top, match):
    started = time.time()
    counts = reader.survey(box)
    if match:
        counts = {k: v for k, v in counts.items() if match.lower() in k.lower()}
    if not counts:
        print("nothing found" + (f" matching '{match}'" if match else ""))
        return 1
    total = sum(counts.values())
    ranked = sorted(counts.items(), key=lambda kv: -kv[1])
    print(f"{total:,} blocks, {len(counts)} distinct ids  ({time.time() - started:.2f}s)")
    for name, count in ranked[:top]:
        print(f"  {count:>10,}  {name}")
    if len(ranked) > top:
        print(f"  ... and {len(ranked) - top} more (raise --top to see them)")
    return 0


def report_check(reader, box, margin, max_columns, as_text):
    """A whole box, described from the files rather than from a tool's own report.

    JSON by default: the usual caller is another tool or the assistant, checking that a
    write landed. --text is for reading it yourself.
    """
    import verify

    found = verify.report(reader, box, margin=margin, max_columns=max_columns)
    if not as_text:
        # Compact on purpose. Indented, the per-column list runs to five lines a
        # column, and the usual reader of this is paying by the token.
        print(json.dumps(found))
        return 0

    x1, y1, z1, x2, y2, z2 = found["box"]
    print(f"{x1} {y1} {z1} .. {x2} {y2} {z2}   {found['volume']:,} blocks, "
          f"{found['distinct_ids']} distinct ids")
    for name, count in list(found["blocks"].items())[:10]:
        print(f"  {count:>10,}  {name}")
    if found["distinct_ids"] > 10:
        print(f"  ... and {found['distinct_ids'] - 10} more ids")

    surface = found["surface"]
    span = (f"y {surface['min']}..{surface['max']}"
            if surface["min"] is not None else "no surface anywhere in the box")
    print(f"surface: {surface['columns']:,} column(s), {span}, "
          f"{len(surface['levels'])} distinct level(s)")

    voids = found["voids"]
    print(f"voids: {voids['empty_columns']:,} empty column(s), "
          f"{voids['undermined_columns']:,} with holes under the surface")
    for x, z, y, holes in voids["undermined"][:10]:
        print(f"  {x} {z}: surface y{y}, {holes} hole(s) below it")

    if found["foreign"] is None:
        print(f"foreign: not derived — {found.get('foreign_note', 'no comparison')}")
    elif found["foreign"]:
        print("foreign (present here, absent from the terrain around this box):")
        for name, count in sorted(found["foreign"].items(), key=lambda kv: -kv[1]):
            print(f"  {count:>10,}  {name}")
    else:
        print("foreign: nothing here that the surrounding terrain does not also use")
    print(f"entities: {found['entities']}")
    return 0


def matches(reader, text, box):
    """Every block in the box whose id contains text, in scan order."""
    x1, y1, z1, x2, y2, z2 = region._ordered(box)
    needle = text.lower()
    for cx in range(x1 >> 4, (x2 >> 4) + 1):
        for cz in range(z1 >> 4, (z2 >> 4) + 1):
            chunk = reader.chunk(cx, cz)
            if not chunk:
                continue
            ox, oz = cx * 16, cz * 16
            for section_y in range(y1 >> 4, (y2 >> 4) + 1):
                # Skip a whole section when its palette cannot contain a match.
                found = chunk.sections.get(section_y)
                if not found or not any(n and needle in n.lower() for n in found[0]):
                    continue
                for lx, wy, lz, name in chunk.section_blocks(section_y):
                    wx, wz = ox + lx, oz + lz
                    if (name and needle in name.lower()
                            and x1 <= wx <= x2 and z1 <= wz <= z2 and y1 <= wy <= y2):
                        yield (wx, wy, wz, name)


def report_find(reader, text, box, limit):
    """Every match is scanned; only the printing is limited.

    Stopping the scan at the limit used to hide the extent. Chunks are scanned in
    ascending order, so a truncated result always lost the far end of whatever was
    found — and the printed coordinates looked like the whole thing. A tunnel bored
    from that answer stopped short at one end, every time. The scan costs
    hundredths of a second, so there is nothing to gain by ending it early.
    """
    hits = list(matches(reader, text, box))
    if not hits:
        print(f"no block id containing '{text}' in that box")
        return 1

    xs = [h[0] for h in hits]
    ys = [h[1] for h in hits]
    zs = [h[2] for h in hits]
    kinds = {}
    for *_, name in hits:
        kinds[name] = kinds.get(name, 0) + 1

    # The extent comes first, because it is the answer to the question that is
    # usually being asked: how far does this thing go?
    print(f"{len(hits):,} match(es)")
    print(f"extent: x {min(xs)}..{max(xs)}  y {min(ys)}..{max(ys)}  z {min(zs)}..{max(zs)}")
    if len(kinds) > 1:
        print("kinds: " + ", ".join(f"{n} x{c:,}"
                                    for n, c in sorted(kinds.items(), key=lambda kv: -kv[1])))
    for x, y, z, name in itertools.islice(hits, limit):
        print(f"  {x} {y} {z}  {name}")
    if len(hits) > limit:
        print(f"  ... {len(hits) - limit:,} more not shown — the extent above covers "
              f"all {len(hits):,}")
    return 0


def main() -> None:
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__)

    dimension = take(args, "--dimension", str, "minecraft:overworld")
    top = take(args, "--top", int, 15)
    limit = take(args, "--limit", int, 50)
    match = take(args, "--match", str, None)
    margin = take(args, "--margin", int, 8)
    max_columns = take(args, "--max-columns", int, 1024)
    no_flush = "--no-flush" in args
    verify = "--verify" in args
    as_text = "--text" in args
    args = [a for a in args if a not in ("--no-flush", "--verify", "--text")]

    try:
        if args[0] == "dimensions":
            for dim in region.dimensions():
                print(f"  {dim}")
            return

        reader = region.Reader(dimension)
        if not no_flush:
            # Without this, anything built since the last save is simply not there.
            reader.flush()

        if args[0] == "survey":
            box = coords(args[1:], 6)
            if len(box) != 6:
                sys.exit("survey needs six coordinates: x1 y1 z1 x2 y2 z2")
            sys.exit(report_survey(reader, box, top, match))

        if args[0] == "check":
            box = coords(args[1:], 6)
            if len(box) != 6:
                sys.exit("check needs six coordinates: x1 y1 z1 x2 y2 z2")
            sys.exit(report_check(reader, box, margin, max_columns, as_text))

        if args[0] == "find":
            if len(args) < 8:
                sys.exit("find needs a search word and six coordinates")
            box = coords(args[2:], 6)
            sys.exit(report_find(reader, args[1], box, limit))

        point = coords(args, 3)
        if len(point) != 3:
            sys.exit(__doc__)
        sys.exit(report_point(reader, *point, verify))

    except region.RegionError as e:
        sys.exit(str(e))
    except RconError as e:
        sys.exit(f"rcon failed: {e} — pass --no-flush to read the last save anyway")


if __name__ == "__main__":
    main()
