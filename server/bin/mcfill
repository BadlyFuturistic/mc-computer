#!/usr/bin/env python3
"""mcfill — change a large region of the world in one command.

  mcfill <x1> <y1> <z1> <x2> <y2> <z2> <block> [--replace <filter>] [options]

  mcfill 100 60 100 200 90 200 minecraft:glass --replace #minecraft:logs
  mcfill 100 60 100 200 90 200 minecraft:glass --replace #minecraft:leaves
  mcfill -50 40 -50 50 120 50 minecraft:tnt --replace #minecraft:base_stone_overworld

  --replace <filter>   only change blocks matching this block or #tag
  --dimension <dim>    default minecraft:overworld
  --force              proceed past the size warning
  --dry-run            report what would run, change nothing

Trees, in one call and in the safe order:

  mcfill <box> --trees --leaves-to <block> --logs-to <block>

  --leaves-to <block>  what leaves become        (default #minecraft:leaves)
  --logs-to <block>    what logs become          (default #minecraft:logs)
  --leaves-from <f>    override the leaf filter
  --logs-from <f>      override the log filter

Order matters and is not obvious: naturally grown leaves decay once no log remains
within range, so converting the logs first makes the leaves disappear before you can
convert them. --trees always does leaves first, which is why it exists.

Minecraft caps /fill at 32768 blocks, so a real request — a forest, a hillside — is
dozens of commands with the slicing worked out by hand. Getting that arithmetic wrong
leaves gaps or overlaps, and doing it a command at a time is slow and expensive.

This slices the region, force-loads each slice, runs its fills over one RCON
connection, and releases the chunks again. Block tags do the selection work:
#minecraft:logs and #minecraft:leaves are every tree, whatever species.
"""
import sys
from pathlib import Path

sys.path.insert(0, "/opt/mc")
from mcrcon import Rcon, RconError

MAX_BLOCKS_PER_FILL = 32768      # hard server limit
MAX_CHUNKS_LOADED = 200          # forceload caps around 256; stay clear of it
WARN_VOLUME = 4_000_000          # above this, require --force


def slices(x1, y1, z1, x2, y2, z2):
    """Split the box into pieces small enough for one /fill each."""
    x1, x2 = sorted((x1, x2)); y1, y2 = sorted((y1, y2)); z1, z2 = sorted((z1, z2))
    # Pick a footprint that keeps each slice's chunk count loadable, then choose the
    # slab height that fills the block budget.
    step = 48
    for sx in range(x1, x2 + 1, step):
        for sz in range(z1, z2 + 1, step):
            ex, ez = min(sx + step - 1, x2), min(sz + step - 1, z2)
            area = (ex - sx + 1) * (ez - sz + 1)
            dy = max(1, MAX_BLOCKS_PER_FILL // area)
            for sy in range(y1, y2 + 1, dy):
                ey = min(sy + dy - 1, y2)
                yield sx, sy, sz, ex, ey, ez


def validate(r, block, replace, dimension):
    """Reject an unknown block or filter before doing any work.

    A mistyped or invented block id fails identically on every slice, so without this
    a bad guess grinds through a hundred-plus commands, changes nothing, and blocks
    every other request for minutes.
    """
    for value, what in ((block, "block"), (replace, "filter")):
        if not value:
            continue
        probe = (f"execute in {dimension} run fill 0 -64 0 0 -64 0 {value}"
                 if what == "block" else
                 f"execute in {dimension} run fill 0 -64 0 0 -64 0 minecraft:air replace {value}")
        out = r.command(probe)
        if "Unknown block" in out or "Unknown tag" in out or "<--[HERE]" in out:
            name = out.split("'")[1] if "'" in out else value
            raise ValueError(
                f"unknown {what}: {name}. Check the exact id — mod blocks rarely match "
                f"the name used in game. /opt/mc/mcblocks <search> lists real ids.")


def run_fill(x1, y1, z1, x2, y2, z2, block, replace, dimension, dry, label=""):
    """One region change, sliced under the fill cap. Returns blocks changed."""
    pieces = list(slices(x1, y1, z1, x2, y2, z2))
    volume = (abs(x2 - x1) + 1) * (abs(y2 - y1) + 1) * (abs(z2 - z1) + 1)
    print(f"{label}{volume:,} blocks in {len(pieces)} fill(s)"
          f"{' matching ' + replace if replace else ''}")
    if dry:
        return 0

    ctx = f"execute in {dimension} run "
    suffix = f" replace {replace}" if replace else ""
    changed, failed, consecutive = 0, 0, 0
    with Rcon() as r:
        validate(r, block, replace, dimension)
        for i, (sx, sy, sz, ex, ey, ez) in enumerate(pieces, 1):
            r.command(f"{ctx}forceload add {sx} {sz} {ex} {ez}")
            out = r.command(f"{ctx}fill {sx} {sy} {sz} {ex} {ey} {ez} {block}{suffix}")
            r.command(f"{ctx}forceload remove {sx} {sz} {ex} {ez}")
            if "Successfully filled" in out:
                changed += int("".join(c for c in out.split("filled")[1] if c.isdigit()) or 0)
            elif "No blocks were filled" not in out and out:
                failed += 1
                consecutive += 1
                if failed <= 3:
                    print(f"  slice {i}: {out[:120]}", file=sys.stderr)
                # Slices fail for the same reason or not at all. Grinding through the
                # rest wastes minutes and holds up every other request.
                if consecutive >= 3:
                    raise ValueError(
                        f"stopping after {consecutive} consecutive failures at slice "
                        f"{i} of {len(pieces)} — the remaining slices will fail the "
                        f"same way. Last error: {out[:140]}")
            else:
                consecutive = 0
            if i % 20 == 0:
                print(f"  {i}/{len(pieces)} slices, {changed:,} blocks so far", flush=True)
    print(f"{label}changed {changed:,} block(s)"
          + (f", {failed} slice(s) failed" if failed else ""))
    return changed


def main() -> None:
    args = sys.argv[1:]
    force = "--force" in args
    dry = "--dry-run" in args
    trees = "--trees" in args
    opts = {
        "replace": None, "dimension": "minecraft:overworld",
        "leaves-to": None, "logs-to": None,
        "leaves-from": "#minecraft:leaves", "logs-from": "#minecraft:logs",
    }
    for key in list(opts):
        flag = f"--{key}"
        if flag in args:
            i = args.index(flag)
            opts[key] = args[i + 1]
            del args[i:i + 2]
    coords = [a for a in args if not a.startswith("--")]

    if trees:
        if len(coords) != 6:
            sys.exit("usage: mcfill <x1> <y1> <z1> <x2> <y2> <z2> --trees "
                     "--leaves-to <block> --logs-to <block>")
        if not (opts["leaves-to"] and opts["logs-to"]):
            sys.exit("--trees needs both --leaves-to and --logs-to")
    elif len(coords) != 7:
        sys.exit(__doc__)

    try:
        nums = [int(c) for c in coords[:6]]
    except ValueError:
        sys.exit("coordinates must be integers")
    x1, y1, z1, x2, y2, z2 = nums

    volume = (abs(x2 - x1) + 1) * (abs(y2 - y1) + 1) * (abs(z2 - z1) + 1)
    if volume > WARN_VOLUME and not force:
        sys.exit(f"refusing: {volume:,} blocks is very large and will lag the server. "
                 f"Narrow the region, or pass --force if this is intended.")

    try:
        if trees:
            # Leaves first, always. Natural leaves decay once no log remains within
            # range, so doing the logs first destroys the leaves before they can be
            # converted. Both halves live in one command precisely so the order
            # cannot be got wrong.
            run_fill(x1, y1, z1, x2, y2, z2, opts["leaves-to"], opts["leaves-from"],
                     opts["dimension"], dry, label="leaves: ")
            run_fill(x1, y1, z1, x2, y2, z2, opts["logs-to"], opts["logs-from"],
                     opts["dimension"], dry, label="logs:   ")
            return

        block = coords[6]
        target = (opts["replace"] or "").lower()
        if ("log" in target or "stem" in target) and not force:
            print("note: replacing logs on their own makes nearby natural leaves decay. "
                  "Use --trees to convert leaves first if that matters.", file=sys.stderr)
        run_fill(x1, y1, z1, x2, y2, z2, block, opts["replace"], opts["dimension"], dry)
    except ValueError as e:
        sys.exit(str(e))
    except RconError as e:
        sys.exit(f"rcon failed: {e}")


if __name__ == "__main__":
    main()
