#!/usr/bin/env python3
"""mcrepave — put a road surface back by copying the intact road either side of it.

  mcrepave <y> <x1> <z1> <x2> <z2> [--dimension <dim>] [--sample 30] [--dry-run]

  mcrepave 63 -2355 239 -2324 243        repave the strip a tunnel just cleared

  <y>                the level the markings sit at; the road surface is <y> - 1
  --sample <n>       how much intact road to read when working out the repeat
  --dry-run          report what would be copied, change nothing
  --dimension <dim>  default minecraft:overworld

Painted road markings are directional blocks, and their facing cannot be worked out by
reasoning about it. Placing them by name alone gives whatever the default rotation is —
markings across the road instead of along it. Setting a facing by hand fixes one side and
mirrors the other, because the two edge lines of a road face opposite ways. Both have
happened repeatedly, each time costing several rounds of the player saying it is still
wrong.

Nothing here decides what a block should look like. For every column along the road it
finds the intact surface just beyond the damaged span and clones it in, so the exact block
state comes from a block that is already correct — facing, mirroring and all.

The pattern along the road is preserved too. Each column is sampled to find how it
repeats: an unbroken edge line repeats every block, a dashed centre line every fifth. The
copy is taken from the position matching the same phase, so dashes line up across the
join instead of restarting at the seam.

What counts as road is read from the carriageway, never assumed. The surface is the row
directly under the markings — the one row boring a tunnel does not touch — so it is still
there to be read, and a position counts as road only if it stands on that surface. Both
ends of every copy are held to it: nothing is read from a place that is not road, and
nothing is written to one.

That check is the whole safety of this tool. Without it, "is there anything here?" was the
only test, an absent chunk was the only thing that failed it, and solid rock passed
easily. Pointed just past the mouth of a tunnel that had stopped at its search limit
inside a hill, it read the hillside, called it road, and cloned 1190 blocks of stone, coal
ore and dirt into the tunnel that had just been cleared — reporting every one as a
success.
"""
import sys
from collections import Counter

sys.path.insert(0, "/opt/mc")
import builder  # noqa: E402
import region  # noqa: E402
import roads  # noqa: E402
import verify  # noqa: E402
from mcrcon import Rcon, RconError  # noqa: E402

SAMPLE = 30           # how much intact road to read when working out the repeat
WINDOW = 256          # blocks written per force-load, to stay inside the chunk cap
SETTLE = 0.6          # seconds for force-loaded chunks to become writable


AIR = {"minecraft:air", "minecraft:cave_air", "minecraft:void_air"}
BARE = ""             # road with no marking on it, which is evidence like any other


def marking(name: str | None) -> str | None:
    """What is painted at a spot: the marking, BARE for none, or None for unknown.

    Three states, not two, and the third is what took several tries to get right. Snow,
    grass and litter drift onto a road. They are not markings, and they are not evidence
    that a spot is unmarked either, because they hide whatever is underneath. Counting
    them as bare inflates the repeat — a side line painted on every block, with snow
    lying on a few of them, read as a pattern twenty-two long and came back full of
    holes. Counting them as markings copies the snow along instead.
    """
    if name is None:
        return None
    if name in AIR:
        return BARE
    return None if region.passable(name) else name


def marks_in(names: list[str | None]) -> int:
    """How many painted markings a sample holds, ignoring what has drifted onto it."""
    return sum(1 for n in names if marking(n))


def repeat_length(names: list[str | None]) -> int:
    """The shortest length at which this column repeats.

    An unknown spot matches anything, since something lying on the road says nothing
    about what is painted under it. Bare road is a real value and matches only bare
    road, which is what keeps a centre line dashed instead of solid.
    """
    n = len(names)
    for p in range(1, n):
        if all(names[i] is None or names[i + p] is None or names[i] == names[i + p]
               for i in range(n - p)):
            return p
    return max(1, n)


def road_surface(reader, y, x1, z1, x2, z2) -> str | None:
    """What this road is paved with, read from under the strip being repaved.

    Markings sit on top of the carriageway, so the row at y - 1 is the road itself. A
    bore clears the markings and leaves that row alone, which makes it the one piece of
    evidence still standing after the damage: it says what the road is made of without
    anyone having to name it, and it keeps working when the road is asphalt in one
    place and something else in another.

    The commonest solid block wins. A strip that runs off the end of the road picks up
    stone and dirt along the way, and those must not be allowed to redefine the road.
    """
    counts: Counter = Counter()
    for x in range(x1, x2 + 1):
        for z in range(z1, z2 + 1):
            name = reader.block(x, y - 1, z)
            if name and not region.passable(name):
                counts[name] += 1
    return counts.most_common(1)[0][0] if counts else None


def on_road(reader, y, x, z, surface: str) -> bool:
    """Whether this spot is carriageway, decided by what holds it up."""
    return reader.block(x, y - 1, z) == surface


def at(t: int, across: int, along_x: bool) -> tuple[int, int]:
    """World x, z from a position along the road and one across it."""
    return (t, across) if along_x else (across, t)


def sample_road(reader, y, anchor, step, across, along_x, length, surface):
    """Read outward from `anchor`, stopping where the road stops.

    Returns block ids nearest-first. The walk ends at the first position that is not
    standing on the road, so a sample cannot run off the end of the carriageway and
    keep reading whatever is beyond it.
    """
    names = []
    for i in range(length):
        x, z = at(anchor + step * i, across, along_x)
        if not on_road(reader, y, x, z, surface):
            break
        names.append(reader.block(x, y, z))
    return names


def main() -> None:
    args = sys.argv[1:]

    def take(flag, cast=str, default=None):
        if flag in args:
            i = args.index(flag)
            value = cast(args[i + 1])
            del args[i:i + 2]
            return value
        return default

    dimension = take("--dimension", str, "minecraft:overworld")
    sample_len = take("--sample", int, SAMPLE)
    dry = "--dry-run" in args
    nums = [a for a in args if not a.startswith("--")]
    if len(nums) != 5:
        sys.exit(__doc__)
    try:
        y, x1, z1, x2, z2 = (int(v) for v in nums)
    except ValueError:
        sys.exit("all five values must be whole numbers")
    x1, x2 = sorted((x1, x2))
    z1, z2 = sorted((z1, z2))

    try:
        reader = region.Reader(dimension)
        reader.flush()

        # Which way the road runs comes from the road, not from the shape of the strip.
        # Reading the long side as the road holds for a hundred blocks of damage and
        # fails on the short ones: a bore of a single block hands this a strip 1 along
        # and 5 across, so it decided the road ran across itself, sampled the tunnel
        # walls for road, and cloned those into the floor.
        along_x = roads.direction(reader, y - 1, (x1 + x2) // 2, (z1 + z2) // 2)
        lo, hi = (x1, x2) if along_x else (z1, z2)
        acrosses = range(z1, z2 + 1) if along_x else range(x1, x2 + 1)

        surface = road_surface(reader, y, x1, z1, x2, z2)
        if surface is None:
            sys.exit(
                f"nothing solid under y={y} anywhere in this strip, so there is no road "
                f"here to match. Check the level: markings sit at the tunnel floor and "
                f"the carriageway is the row below it.")

        # A presence check is not an identity check. road_surface takes the commonest
        # solid block under the strip, and one level too low that is whatever the road
        # was built on rather than the road. Asked to repave at the carriageway level
        # instead of the marking level, it read stone from below the asphalt, called
        # stone the road surface, and laid stone across the road for 300 blocks.
        if not roads.carriageway_near(reader, y - 1, lo, hi, acrosses, along_x):
            sys.exit(
                f"the row under y={y} is not carriageway at either end of this strip, "
                f"so there is no road here to copy. Markings sit one block above the "
                f"road surface: check that y={y} is the marking level and not the "
                f"carriageway itself.")

        print(f"road surface: {surface} (read from y={y - 1} under the strip)")
        print(f"road runs along {'x' if along_x else 'z'}")

        plans = []          # (source t, target t, across, block name)
        off_road = 0
        for across in acrosses:
            # Read the intact road past both ends of the damage, nearest block first,
            # and work from whichever side can actually teach the pattern.
            low = sample_road(reader, y, lo - 1, -1, across, along_x,
                              sample_len, surface)
            high = sample_road(reader, y, hi + 1, +1, across, along_x,
                               sample_len, surface)
            if not low and not high:
                print(f"{'z' if along_x else 'x'}={across}: no intact road either side "
                      f"— skipped", file=sys.stderr)
                continue
            # Markings first, length second. Both sides being road says nothing about
            # which one knows the pattern: a stretch extended without markings sits
            # right beside one that has them, and choosing by length alone read the
            # bare side, learned nothing, and planned to clear the strip to air.
            if (marks_in(high), len(high)) > (marks_in(low), len(low)):
                anchor, step, names = hi + 1, +1, high
            else:
                anchor, step, names = lo - 1, -1, low

            clean = [marking(n) for n in names]
            period = repeat_length(clean)

            # One source block per position in the repeat, chosen from the sample so
            # that what gets cloned is a marking that is already correct rather than
            # whatever happened to be lying at that spot.
            template: dict[int, tuple[str, int] | None] = {p: None
                                                           for p in range(period)}
            for i, name in enumerate(clean):
                if name is None:
                    continue          # hidden under something; teaches nothing
                # Phase is measured in world coordinates from the anchor, so the copy
                # and the place it lands agree regardless of which side was sampled.
                # Deriving it from the sample index instead put the source of every
                # copy taken from the far side back inside the damage.
                t = anchor + step * i
                if template[(t - anchor) % period] is None:
                    template[(t - anchor) % period] = (name, t)

            unknown = 0
            for t in range(lo, hi + 1):
                x, z = at(t, across, along_x)
                if not on_road(reader, y, x, z, surface):
                    off_road += 1
                    continue
                entry = template[(t - anchor) % period]
                if entry is None:
                    unknown += 1      # no evidence for this phase: leave it alone
                    continue
                name, src_t = entry
                plans.append((None if name is BARE else src_t, t, across,
                              None if name is BARE else name))

            kinds = sorted({v[0] for v in template.values() if v and v[0] is not BARE})
            print(f"{'z' if along_x else 'x'}={across}: {len(names)} block(s) of intact "
                  f"road {'ahead' if step > 0 else 'behind'}, repeats every {period} "
                  f"block(s)"
                  f"{' — ' + ', '.join(k.split(':')[-1] for k in kinds) if kinds else ' — bare'}")

        if off_road:
            print(f"{off_road} block(s) skipped: not standing on {surface}. That much "
                  f"of this strip is not road — it still needs paving.", file=sys.stderr)
        if not plans:
            sys.exit(
                f"refusing: found no intact {surface} either side of this strip to copy "
                f"from. Repaving needs a piece of finished road to match; there is none "
                f"here, so there is nothing to say what the markings should be.")
        print(f"{len(plans)} block(s) to repave from "
              f"{len(set(p[2] for p in plans))} column(s)")
        if dry:
            for src, t, across, name in plans[:10]:
                x, z = at(t, across, along_x)
                sx, sz = at(src, across, along_x) if src is not None else (None, None)
                print(f"  {x} {y} {z}  <- {sx} {sz} ({name})"
                      if src is not None else f"  {x} {y} {z}  <- air")
            if len(plans) > 10:
                print(f"  ... and {len(plans) - 10} more")
            return

        ctx = f"execute in {dimension} run "
        pad = sample_len + 2
        a_lo, a_hi = min(acrosses), max(acrosses)

        def box_for(t1, t2):
            p1x, p1z = at(t1, a_lo, along_x)
            p2x, p2z = at(t2, a_hi, along_x)
            return (min(p1x, p2x) - 1, min(p1z, p2z) - 1,
                    max(p1x, p2x) + 1, max(p1z, p2z) + 1)

        # Written in windows, because `forceload add` refuses more than 256 chunks and
        # loads none of them when it refuses. One command for the whole strip covered
        # 2,538 blocks of road, so 9,578 of 12,690 markings went into chunks that were
        # not there. The two ends stay loaded throughout: the marking being copied sits
        # just beyond one end of the strip and lands anywhere along it.
        ends = [box_for(lo - pad, lo - 1), box_for(hi + 1, hi + pad)]
        windows: dict[int, list] = {}
        for plan in plans:
            windows.setdefault((plan[1] - lo) // WINDOW, []).append(plan)

        # The strip itself, at marking level. Not box_for's padded version: that reaches
        # a block past each kerb, where grass and dirt belong and would read as strays.
        p1x, p1z = at(lo, a_lo, along_x)
        p2x, p2z = at(hi, a_hi, along_x)
        watch = verify.Watch(dimension, (min(p1x, p2x), y, min(p1z, p2z),
                                         max(p1x, p2x), y, max(p1z, p2z)))
        # Every marking any column plans to lay. `kinds` above is only the last column's.
        placing = {name for *_, name in plans if name} | {"minecraft:air"}

        with Rcon() as rcon:
            import time
            marked = cleared = already = failed = 0
            try:
                for w in sorted(windows):
                    start = lo + w * WINDOW
                    box = box_for(start, min(start + WINDOW - 1, hi))
                    builder.forceload(rcon, ctx, box, add=True)
                    for end_box in ends:
                        builder.forceload(rcon, ctx, end_box, add=True)
                    time.sleep(SETTLE)
                    for src, t, across, _ in windows[w]:
                        x, z = at(t, across, along_x)
                        if src is None:
                            # Nothing marked at this phase — clear it rather than
                            # leaving whatever the damage left behind.
                            out = rcon.command(
                                f"{ctx}setblock {x} {y} {z} minecraft:air")
                            if "Changed the block" in out:
                                cleared += 1
                            elif "Could not set the block" in out:
                                # Already empty. Minecraft calls setting a block to what
                                # it already is a failure, and counting it as one turned
                                # a clean run over bare carriageway into "363 of 825" —
                                # a number that reads as damage and invites someone to
                                # go looking for it. A position already right is done.
                                already += 1
                            else:
                                failed += 1
                            continue
                        # clone, not setblock: the whole point is to carry the block
                        # state across rather than name it, since naming it keeps
                        # failing.
                        sx, sz = at(src, across, along_x)
                        out = rcon.command(f"{ctx}clone {sx} {y} {sz} {sx} {y} {sz} "
                                           f"{x} {y} {z}")
                        if "cloned" in out.lower():
                            marked += 1
                        else:
                            failed += 1
                    builder.forceload(rcon, ctx, box, add=False)
            finally:
                for end_box in ends:
                    builder.forceload(rcon, ctx, end_box, add=False)
        # A clone reports success for whatever was at the source. That is how a hillside
        # ended up in a bored tunnel, 1190 blocks, every one of them reported as a
        # marking. Read the strip back and see what is really standing on it.
        problem = watch.unexpected(placing)
        if watch.note:
            print(f"note: {watch.note}", file=sys.stderr)
        if problem:
            sys.exit(f"the repave reported success and the world disagrees: {problem}. "
                     f"The source it cloned from was not road. Check y={y - 1} under "
                     f"both ends of the strip before running it again.")
        print(f"repaved {marked + cleared + already} of {len(plans)} block(s): "
              f"{marked} marking(s) cloned, {cleared} cleared, "
              f"{already} already right")
        if failed:
            sys.exit(f"{failed} block(s) would not take the change. The strip is part "
                     f"repaved; re-run once you know why.")

    except region.RegionError as e:
        sys.exit(str(e))
    except RconError as e:
        sys.exit(f"rcon failed: {e}")


if __name__ == "__main__":
    main()
