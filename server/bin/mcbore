#!/usr/bin/env python3
"""mcbore — cut a tunnel through whatever is in the way, both ends found for you.

  mcbore --player <name> [options]
  mcbore <x> <y> <z> --facing <+x|-x|+z|-z> [options]

  mcbore --player <name> --width 5 --line minecraft:stone_bricks \\
         --light minecraft:glowstone --every 3

  --player <name>    start at their feet, bore the way they are looking
  --facing <dir>     direction, when no player is given
  --width <n>        inside width, across the tunnel   (default 3)
  --height <n>       inside height                     (default 3)
  --floor <y>        floor level; default is the ground the player stands on
  --line <block>     line the walls and ceiling with this
  --support <block>  cap the ceiling only, when sand or gravel sits above
  --repave           put the floor markings back afterwards (see mcrepave)
  --no-align         centre on the player, not on the road underfoot
  --floor-too        line the floor as well (off by default; roads have their own)
  --light <block>    put lights in the ceiling
  --every <n>        light spacing along the tunnel    (default 5)
  --max <n>          furthest it will look ahead       (default 160)
  --dry-run          report what it found, change nothing
  --dimension <dim>  default minecraft:overworld

Boring a tunnel by hand means working out where the hill starts and where it ends, and
getting either wrong leaves a wall of rock across the road. The end nearest the player
is the one usually missed, because it is behind them in scan order and easy to cut off
a search on.

This finds both ends itself. It steps forward from the start, testing the whole
cross-section of the tunnel at each step, and takes the first blocked step as the
entrance and the last as the far side — so an entrance right in front of the player is
found by the same pass that finds the exit. Reading the world files makes that scan
cost hundredths of a second.

When it is following a road it stops where the road stops. A hill and the road running
into it are different things, and looking only for solid rock cannot tell them apart:
one run carried on 73 blocks out the far side of the carriageway, leaving lined tunnel
with nothing to drive on. Boring with no road at all is unchanged and still unbounded —
that is what --no-align and explicit coordinates are for.

Blocks are read from the last save and written over RCON, as everywhere else.
"""
import math
import re
import subprocess
import sys
import time

sys.path.insert(0, "/opt/mc")
import builder  # noqa: E402
import region  # noqa: E402
import roads  # noqa: E402
from mcrcon import Rcon, RconError  # noqa: E402

SETTLE = 0.6          # seconds for force-loaded chunks to become writable
CLEAR_RUN = 4         # this many clear steps in a row means we are out the far side
MARGIN = 2            # chunks of slack when force-loading

FACINGS = {"+x": (1, 0), "-x": (-1, 0), "+z": (0, 1), "-z": (0, -1)}


def facing_from_yaw(yaw: float) -> str:
    """Minecraft yaw: 0 is +z, 90 is -x, 180 is -z, 270 is +x."""
    y = yaw % 360
    if y < 45 or y >= 315:
        return "+z"
    if y < 135:
        return "-x"
    if y < 225:
        return "-z"
    return "+x"


def player_state(name: str):
    """Feet position and facing, straight from the server — this must be live."""
    out = subprocess.run(
        ["/opt/mc/mccmd"], input=f"data get entity {name} Pos\n"
        f"data get entity {name} Rotation\n",
        capture_output=True, text=True).stdout
    pos = re.search(r"\[(-?[\d.]+)d, (-?[\d.]+)d, (-?[\d.]+)d\]", out)
    rot = re.search(r"\[(-?[\d.]+)f", out)
    if not pos or not rot:
        sys.exit(f"could not read {name}'s position — are they online?")
    x, y, z = (float(v) for v in pos.groups())
    yaw = float(rot.group(1))
    return x, y, z, facing_from_yaw(yaw), yaw


def cells(step_x, step_z, half, height, floor_y, along_x, from_row=0):
    """Every block of one cross-section of the tunnel, from `from_row` upward."""
    for w in range(-half, half + 1):
        for h in range(from_row, height):
            if along_x:
                yield step_x, floor_y + h, step_z + w
            else:
                yield step_x + w, floor_y + h, step_z


def find_mass(reader, start, facing, half, height, floor_y, limit):
    """Walk forward and report (first blocked step, last blocked step).

    Both ends come out of one pass, which is the whole point: the near end cannot be
    lost to a search that stopped early, because nothing stops early.

    The floor row is not counted. Roads carry a surface, painted lines, rails and
    carpets at exactly that level, and treating those as an obstruction starts the
    tunnel at the player's own feet and bricks up open road. What blocks a tunnel is
    what stands at body height.
    """
    dx, dz = FACINGS[facing]
    along_x = dx != 0
    x0, z0 = start
    enter = exit_ = None
    clear_run = 0
    from_row = 1 if height > 1 else 0
    for step in range(limit + 1):
        sx, sz = x0 + dx * step, z0 + dz * step
        blocked = any(not region.passable(reader.block(*c))
                      for c in cells(sx, sz, half, height, floor_y, along_x, from_row))
        if blocked:
            if enter is None:
                enter = step
            exit_ = step
            clear_run = 0
        elif enter is not None:
            clear_run += 1
            if clear_run >= CLEAR_RUN:
                break
    return enter, exit_


def block_cells(box):
    x1, y1, z1, x2, y2, z2 = box
    return {(x, y, z)
            for x in range(x1, x2 + 1)
            for y in range(y1, y2 + 1)
            for z in range(z1, z2 + 1)}


def ceiling_cells(inside, along_x: bool):
    """The layer directly over the tunnel — what holds up whatever is above it."""
    x1, y1, z1, x2, y2, z2 = inside
    if along_x:
        return {(x, y2 + 1, z)
                for x in range(x1, x2 + 1) for z in range(z1 - 1, z2 + 2)}
    return {(x, y2 + 1, z)
            for z in range(z1, z2 + 1) for x in range(x1 - 1, x2 + 2)}


def loose_above(reader, inside, along_x: bool):
    """Blocks over the tunnel that will fall the moment the tunnel is hollowed out.

    Sand and gravel are held up by whatever is under them and nothing else. Cut a
    tunnel through a desert and the ceiling does not stay put: it pours into the
    tunnel, and the hole it leaves runs all the way to the surface, so the desert
    above is wrecked as well. Clearing the spill afterwards does not undo either.
    """
    return {c for c in ceiling_cells(inside, along_x) if region.falls(reader.block(*c))}


def lining_cells(inside, along_x: bool, floor_too: bool):
    """The walls and ceiling around a tunnel — and nothing else.

    Two things must not be touched, and growing the tunnel box by one in every
    direction touched both.

    The ends are open by definition. Capping them walls the tunnel off at both
    mouths, which is the opposite of boring through something.

    The floor is not ours. A tunnel carrying a road sits on that road, and the row
    below the tunnel is its surface. Lining it replaces the road; clearing it again
    afterwards deletes the road outright.
    """
    x1, y1, z1, x2, y2, z2 = inside
    cells = set()
    if along_x:
        for x in range(x1, x2 + 1):
            for y in range(y1, y2 + 1):
                cells.add((x, y, z1 - 1))
                cells.add((x, y, z2 + 1))
            for z in range(z1 - 1, z2 + 2):
                cells.add((x, y2 + 1, z))
                if floor_too:
                    cells.add((x, y1 - 1, z))
    else:
        for z in range(z1, z2 + 1):
            for y in range(y1, y2 + 1):
                cells.add((x1 - 1, y, z))
                cells.add((x2 + 1, y, z))
            for x in range(x1 - 1, x2 + 2):
                cells.add((x, y2 + 1, z))
                if floor_too:
                    cells.add((x, y1 - 1, z))
    return cells


def run_length(reader, x, y, z, axis, want, limit=24):
    """How far the same surface continues either way along one axis."""
    lo = hi = 0
    step = (1, 0) if axis == "x" else (0, 1)
    while lo > -limit and reader.block(x + step[0] * (lo - 1), y,
                                       z + step[1] * (lo - 1)) == want:
        lo -= 1
    while hi < limit and reader.block(x + step[0] * (hi + 1), y,
                                      z + step[1] * (hi + 1)) == want:
        hi += 1
    return lo, hi


def find_road(reader, seed, floor_y, width):
    """Find the carriageway near a point, and take the geometry from the road.

    A player's position is a hint about where they mean, not a specification. They
    are never stood exactly in the middle of a lane, and they keep walking after they
    ask — by the time the command runs they may be somewhere else entirely. Anything
    built from their coordinates inherits both errors: a tunnel a block off the road,
    or in the wrong place altogether.

    The road does not move. Its surface is a run of one block a few wide and much
    longer than it is wide, which gives the centre line and the direction it travels
    without asking anybody. Returns (x, z, axis, surface) or None if there is no road
    here; the surface is what the carriageway is paved with, which is how far ahead it
    still counts as road.
    """
    sx, sz = seed
    for dx, dz in ((0, 0), (1, 0), (-1, 0), (0, 1), (0, -1), (2, 0), (-2, 0),
                   (0, 2), (0, -2)):
        x, z = sx + dx, sz + dz
        surface = reader.block(x, floor_y - 1, z)
        if not surface or region.passable(surface):
            continue
        xlo, xhi = run_length(reader, x, floor_y - 1, z, "x", surface)
        zlo, zhi = run_length(reader, x, floor_y - 1, z, "z", surface)
        along_x_len, along_z_len = xhi - xlo + 1, zhi - zlo + 1
        if along_x_len == along_z_len:
            continue                       # square patch says nothing about direction
        axis = "x" if along_x_len > along_z_len else "z"
        across = along_z_len if axis == "x" else along_x_len
        if not (width <= across <= width + 6):
            continue                       # not a corridor the size of this tunnel
        if axis == "x":
            return x, z + (zlo + zhi) // 2, "x", surface
        return x + (xlo + xhi) // 2, z, "z", surface
    return None


def road_end(reader, start, facing, floor_y, surface, limit):
    """The last step ahead that still has carriageway under it.

    A road and the hill it runs into are two different things, and a bore that only
    looks for solid rock cannot tell them apart. Asked to cut through a hill, it kept
    going out the far side of the road and 73 blocks on into open ground, leaving a
    lined tunnel with nothing to drive on.

    The carriageway is the row under the tunnel floor, so following it costs one read
    per step. Where it stops, the job stops: past that point there is no road to carry
    through, and boring further only makes a hole that has to be paved later.
    """
    dx, dz = FACINGS[facing]
    x0, z0 = start
    last = -1
    for step in range(limit + 1):
        if reader.block(x0 + dx * step, floor_y - 1, z0 + dz * step) != surface:
            break
        last = step
    return last


def facing_along(axis: str, yaw: float) -> str:
    """Which way along a road a player is heading, from where they are looking.

    The road decides the axis; the player only chooses which end. Taking the axis
    from their gaze instead lets a glance sideways send a tunnel across the road.
    """
    radians = math.radians(yaw)
    look_x, look_z = -math.sin(radians), math.cos(radians)
    if axis == "x":
        return "+x" if look_x >= 0 else "-x"
    return "+z" if look_z >= 0 else "-z"


def box_for(start, facing, first, last, half, height, floor_y, out=0):
    """The world-space box of the tunnel, optionally grown by `out` on every side."""
    dx, dz = FACINGS[facing]
    ax, az = start[0] + dx * first, start[1] + dz * first
    bx, bz = start[0] + dx * last, start[1] + dz * last
    if dx:
        x1, x2 = sorted((ax, bx))
        z1, z2 = az - half, az + half
    else:
        z1, z2 = sorted((az, bz))
        x1, x2 = ax - half, ax + half
    return (x1 - out, floor_y - out, z1 - out,
            x2 + out, floor_y + height - 1 + out, z2 + out)


def main() -> None:
    args = sys.argv[1:]

    def take(flag, cast=str, default=None):
        if flag in args:
            i = args.index(flag)
            value = cast(args[i + 1])
            del args[i:i + 2]
            return value
        return default

    player = take("--player")
    facing = take("--facing")
    width = take("--width", int, 3)
    height = take("--height", int, 3)
    floor_y = take("--floor", int)
    line = take("--line")
    support = take("--support")
    repave = "--repave" in args
    no_align = "--no-align" in args
    light = take("--light")
    every = take("--every", int, 5)
    limit = take("--max", int, 160)
    dimension = take("--dimension", str, "minecraft:overworld")
    dry = "--dry-run" in args
    floor_too = "--floor-too" in args
    coords = [a for a in args if not a.startswith("--")]

    if width < 1 or height < 1:
        sys.exit("--width and --height must be at least 1")
    half = (width - 1) // 2

    if player:
        px, py, pz, looking, yaw = player_state(player)
        facing = facing or looking
        # Feet sit on top of the block below; the tunnel floor is the block they
        # would walk on. Road surfaces are not always whole blocks, hence the ceil.
        start = (round(px), round(pz))
        if floor_y is None:
            floor_y = math.ceil(py)
    else:
        yaw = None
        if len(coords) != 3 or not facing:
            sys.exit(__doc__)
        try:
            sx, sy, sz = (int(c) for c in coords)
        except ValueError:
            sys.exit("coordinates must be whole numbers")
        start = (sx, sz)
        if floor_y is None:
            floor_y = sy
    if facing not in FACINGS:
        sys.exit(f"--facing must be one of: {', '.join(FACINGS)}")

    try:
        reader = region.Reader(dimension)
        reader.flush()

        surface = None
        if player and not no_align:
            found = find_road(reader, start, floor_y, width)
            if not found:
                sys.exit(
                    f"no road or corridor found near {start[0]} {floor_y} {start[1]}. "
                    f"A player's position only says roughly where they mean, so this "
                    f"will not bore from it blindly — give explicit coordinates and "
                    f"--facing, or stand on the road.")
            rx, rz, axis, surface = found
            was, start, facing = start, (rx, rz), facing_along(axis, yaw)
            if (rx, rz) != was:
                print(f"road found: centred at {rx} {floor_y} {rz}, running along "
                      f"{axis} (you were at {was[0]} {was[1]})")

        # The floor of a road tunnel is the marking level, one block above the
        # carriageway — that is the level a bore may clear, and the asphalt underneath
        # is not its to touch. Given the carriageway itself it cuts the road away: ten
        # bores run at --floor 62 along a road paved at 62 destroyed nearly 700 blocks
        # of it, and the repave that followed then read stone from beneath the cut and
        # called that the road surface. Coordinates come with no such check; a player's
        # feet do, which is why only the explicit form ever got this wrong.
        axis_x = facing in ("+x", "-x")
        across0 = (start[1] - half) if axis_x else (start[0] - half)
        acrosses = range(across0, across0 + width)
        here = start[0] if axis_x else start[1]
        if (not roads.bounded_slice(reader, floor_y - 1, here, acrosses, axis_x)
                and roads.bounded_slice(reader, floor_y, here, acrosses, axis_x)):
            sys.exit(
                f"y={floor_y} is the carriageway here, not the tunnel floor. Boring at "
                f"this level would cut the road away and leave nothing to drive on. The "
                f"floor of a road tunnel is the marking level, one block up: pass "
                f"--floor {floor_y + 1}.")

        # Following a road means going no further than the road goes. Boring with no
        # road is still unbounded: --no-align and explicit coordinates cut through
        # whatever is in the way, which is what they are for.
        road_last = None
        scan = limit
        if surface:
            road_last = road_end(reader, start, facing, floor_y, surface, limit)
            scan = min(limit, road_last)

        first, last = find_mass(reader, start, facing, half, height, floor_y, scan)
        if first is None:
            sys.exit(f"nothing to bore through: clear for {scan} blocks {facing} "
                     f"from {start[0]} {floor_y} {start[1]}")

        length = last - first + 1
        inside = box_for(start, facing, first, last, half, height, floor_y)
        print(f"facing {facing} from {start[0]} {floor_y} {start[1]}")
        print(f"solid from {first} to {last} blocks ahead — {length} long, "
              f"{width} wide, {height} high")
        print(f"tunnel: x {inside[0]}..{inside[3]}  y {inside[1]}..{inside[4]}  "
              f"z {inside[2]}..{inside[5]}")
        if road_last is not None and road_last < limit and last >= road_last:
            dx_, dz_ = FACINGS[facing]
            ex, ez = start[0] + dx_ * road_last, start[1] + dz_ * road_last
            print(f"stopped at the end of the {surface}: it runs out at {ex} "
                  f"{floor_y - 1} {ez}, {road_last} blocks ahead. Pave further to bore "
                  f"further.", file=sys.stderr)
        elif last >= limit:
            print(f"warning: still solid at the {limit}-block limit — raise --max",
                  file=sys.stderr)
        ctx = f"execute in {dimension} run "
        dx, dz = FACINGS[facing]
        interior = block_cells(inside)
        loose = loose_above(reader, inside, dx != 0)

        if line:
            lining = lining_cells(inside, dx != 0, floor_too)
        elif support and loose:
            lining, line = ceiling_cells(inside, dx != 0), support
        else:
            lining = set()

        # Checked before the dry run returns: "this would bury the tunnel in sand" is
        # precisely what a dry run is asked to find out.
        if loose and not lining:
            sys.exit(
                f"refusing: {len(loose)} block(s) of sand or gravel sit directly over "
                f"this tunnel, and would fall into it the moment it is hollowed out — "
                f"taking the ground above with them.\n"
                f"  Give --line <block> to line it, or --support <block> to cap the "
                f"ceiling only. Either one is put in place before anything is removed.")
        if loose:
            print(f"holding up {len(loose)} block(s) of falling material overhead")
        if dry:
            return

        changed = 0
        with Rcon() as rcon:
            # The ceiling goes in *before* the tunnel is hollowed out. Clearing first
            # and lining afterwards leaves a window where nothing is holding the roof
            # up, and sand does not wait: it falls into the tunnel and keeps falling,
            # which is how gravel ended up all over the road on an earlier run.
            if lining:
                changed += builder.write(rcon, dimension, lining, line)
            changed += builder.write(rcon, dimension, interior, "minecraft:air")
            if light:
                ceiling = inside[4] + 1
                load = (inside[0] - MARGIN * 16, inside[2] - MARGIN * 16,
                        inside[3] + MARGIN * 16, inside[5] + MARGIN * 16)
                rcon.command(f"{ctx}forceload add {load[0]} {load[1]} {load[2]} {load[3]}")
                try:
                    time.sleep(SETTLE)
                    for step in range(first, last + 1, max(1, every)):
                        lx = start[0] + dx * step
                        lz = start[1] + dz * step
                        rcon.command(f"{ctx}setblock {lx} {ceiling} {lz} {light}")
                finally:
                    rcon.command(f"{ctx}forceload remove {load[0]} {load[1]} "
                                 f"{load[2]} {load[3]}")

        repaved = None
        if repave:
            # The tunnel floor is where road markings live, so boring always takes
            # them out. Rebuilding them by name gets the rotation wrong; mcrepave
            # copies the intact road either side instead.
            out = subprocess.run(
                ["/opt/mc/mcrepave", str(inside[1]), str(inside[0]), str(inside[2]),
                 str(inside[3]), str(inside[5])], capture_output=True, text=True)
            # Both streams, always. mcrepave says which columns it could not match on
            # stderr, and printing that only when stdout was empty threw away every
            # partial failure — the run that mattered reported nothing but success.
            for stream in (out.stdout, out.stderr):
                if stream.strip():
                    print(stream.strip())
            repaved = out.returncode == 0

        print(f"bored {length} blocks"
              + (f", lined with {line}" if line else "")
              + (f", {light} every {every}" if light else ""))
        if repaved is False:
            # A tunnel with no markings is a job half done, not a job done. Saying
            # "bored N blocks" and stopping let a failed repave read as a success all
            # the way back to the player.
            sys.exit("the tunnel is bored, but repaving failed — see above. The floor "
                     "is bare; nothing has been put back.")

    except region.RegionError as e:
        sys.exit(str(e))
    except ValueError as e:
        sys.exit(str(e))
    except RconError as e:
        sys.exit(f"rcon failed: {e}")


if __name__ == "__main__":
    main()
