#!/usr/bin/env python3
"""mcnote — the bot's memory, from the command line.

  mcnote tell <player> "<message>" --from <player>
        Hold a message for a player and deliver it next time they log in.

  mcnote pending [player]         messages waiting to be delivered
  mcnote delivered <id> [<id>...] mark messages as delivered (after saying them)
  mcnote log <player> "<what they asked for>"
        Record a request, so "what did they ask for while I was away" is answerable.
  mcnote history [--days N]       recent activity, rolled up
  mcnote backups                  backup health verdict

Everything is stored in one SQLite file. Old detail is collapsed into daily summaries
automatically, so this stays small no matter how long it runs.
"""
import sys
from pathlib import Path

sys.path.insert(0, "/opt/mcbot")
import runas  # noqa: E402

runas.ensure_service_user()

import memory


def main() -> None:
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd, args = sys.argv[1], sys.argv[2:]
    db = memory.connect()

    if cmd == "tell":
        if len(args) < 2:
            sys.exit('usage: mcnote tell <player> "<message>" [--from <player>]')
        target, body = args[0], args[1]
        sender = "someone"
        if "--from" in args:
            sender = args[args.index("--from") + 1]
        mid = memory.add_message(db, target, sender, body)
        print(f"held message {mid} for {target}")

    elif cmd == "pending":
        player = args[0] if args else None
        if player:
            rows = memory.pending_messages(db, player)
        else:
            rows = db.execute(
                "SELECT * FROM messages WHERE delivered_at IS NULL ORDER BY created_at"
            ).fetchall()
        if not rows:
            print("nothing pending")
            return
        for r in rows:
            print(f"[{r['id']}] for {r['for_player']} from {r['from_player']}: {r['body']}")

    elif cmd == "delivered":
        ids = [int(a) for a in args if a.isdigit()]
        if not ids:
            sys.exit("usage: mcnote delivered <id> [<id>...]")
        memory.mark_delivered(db, ids)
        print(f"marked delivered: {', '.join(map(str, ids))}")

    elif cmd == "log":
        if len(args) < 2:
            sys.exit('usage: mcnote log <player> "<what they asked for>"')
        memory.log_event(db, "request", args[1], player=args[0])
        print("logged")

    elif cmd == "history":
        days = 3.0
        if "--days" in args:
            days = float(args[args.index("--days") + 1])
        lines = memory.recent_activity(db, since_hours=days * 24)
        print("\n".join(lines) if lines else "no recorded activity")

    elif cmd == "backups":
        print(memory.backup_verdict(db) or "nothing new to report")

    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
