#!/usr/bin/env python3
"""mchealth — is the bot running, healthy, and running what you think it is?

The last part is the one that needs machinery. Comparing files on disk tells you what
was deployed, not what the running process loaded — a deploy without a restart looks
identical from the filesystem. So the daemon records the build it started with, and
this compares that against what is currently installed.

Exit code is 0 when everything is fine, 1 when something needs attention, so it can
be used as a check rather than only read by a human.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/opt/mcbot")

BUILD_FILE = Path("/opt/mcbot/BUILD")          # what is installed
RUNTIME_FILE = Path("/var/lib/mcbot/runtime.json")  # what the process actually loaded
TRANSCRIPT = Path("/var/lib/mcbot/logs/comp.log")
LIMITS = Path("/etc/mcbot/limits")
WAYSTONES = Path("/opt/mc/data/world/data/waystones/waystones.dat")

OK, WARN, BAD = "ok", "warn", "PROBLEM"
findings: list[tuple[str, str, str]] = []


def check(name: str, state: str, detail: str) -> None:
    findings.append((name, state, detail))


def sh(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def mcbot_can_read(path: Path) -> tuple[bool, str]:
    """Whether the *service account* can read a file — not whether we can.

    This tool normally runs as the admin, who has their own access, so opening the file
    here proves nothing about the bot. The answer has to come from the permissions, and
    it has to account for the mask: a file's group bits *are* its ACL mask, so a
    named-user entry can be listed while granting nothing at all.
    """
    out = sh("getfacl", "-p", str(path))
    if not out:
        return False, "cannot read its permissions"

    entries, mask = {}, None
    for line in out.splitlines():
        line = line.split("\t")[0].strip()          # drop any #effective comment
        if not line or line.startswith("#"):
            continue
        parts = line.split(":")
        if len(parts) < 3:
            continue
        kind, who, perms = parts[0], parts[1], parts[2]
        if kind == "mask":
            mask = perms
        else:
            entries[(kind, who)] = perms

    if "r" in entries.get(("other", ""), ""):
        return True, "world-readable"

    def effective(perms: str) -> bool:
        return "r" in perms and (mask is None or "r" in mask)

    if ("user", "mcbot") in entries:
        if effective(entries[("user", "mcbot")]):
            return True, "granted by ACL"
        return False, "the ACL entry for mcbot is masked out by the group bits"

    try:
        import grp
        group = grp.getgrgid(path.stat().st_gid).gr_name
    except (OSError, KeyError, ImportError):
        group = "?"
    if group == "mcbot" and effective(entries.get(("group", ""), "")):
        return True, "group mcbot"
    return False, f"group is {group}, which gives mcbot no access"


def main() -> None:
    # --- service -----------------------------------------------------------
    active = sh("systemctl", "is-active", "mcbot")
    started = sh("systemctl", "show", "mcbot", "-p", "ActiveEnterTimestamp", "--value")
    restarts = sh("systemctl", "show", "mcbot", "-p", "NRestarts", "--value") or "0"
    check("service", OK if active == "active" else BAD, f"{active}, started {started}")
    if restarts not in ("0", ""):
        check("restarts", WARN, f"{restarts} since boot — check the journal for crashes")

    timer = sh("systemctl", "is-active", "mcbot-acl.timer")
    check("acl timer", OK if timer == "active" else WARN,
          timer or "not installed — world data will become unreadable")

    # --- settings the bot is actually obeying ------------------------------
    # A config the service cannot read is not a config. It produced no error and no
    # log line; the bot simply ran on built-in defaults while the admin's settings sat
    # in a file it could not open.
    config_file = Path("/etc/mcbot/config")
    if not config_file.exists():
        check("config", WARN, "/etc/mcbot/config does not exist — running on defaults")
    else:
        readable, why = mcbot_can_read(config_file)
        check("config", OK if readable else BAD,
              why if readable else
              f"mcbot cannot read /etc/mcbot/config ({why}) — every setting is being "
              f"ignored in favour of defaults. Fix: sudo chgrp mcbot "
              f"/etc/mcbot/config && sudo chmod 640 /etc/mcbot/config")

    # --- version -----------------------------------------------------------
    installed = read_json(BUILD_FILE)
    running = read_json(RUNTIME_FILE)
    iv = f"{installed.get('version', '?')} ({installed.get('commit', '?')})"
    rv = f"{running.get('version', '?')} ({running.get('commit', '?')})"
    if not running:
        check("version", WARN, f"installed {iv}; process did not record a build")
    elif installed.get("commit") != running.get("commit"):
        check("version", BAD,
              f"installed {iv} but RUNNING {rv} — deployed without a restart")
    else:
        check("version", OK, f"{rv}, deployed {installed.get('deployed', '?')}")

    # --- can it reach the game? --------------------------------------------
    listing = ""
    try:
        p = subprocess.run(["/opt/mc/mccmd"], input="list\n", capture_output=True,
                           text=True, timeout=15)
        listing = (p.stdout or "").strip()
    except (OSError, subprocess.TimeoutExpired):
        listing = ""
    check("rcon", OK if "players online" in listing else BAD,
          listing or "no response — server down or RCON misconfigured")

    # --- can it read world data? -------------------------------------------
    places = sh("/opt/mc/mcwhere")
    n_places = len([l for l in places.splitlines() if l and not l.startswith("warning")])
    readable = os.access(WAYSTONES, os.R_OK)
    check("world data", OK if readable and n_places else BAD,
          f"{n_places} named places" if readable
          else "waystones unreadable — ACL mask reset, is mcbot-acl.timer running?")

    # --- spend -------------------------------------------------------------
    try:
        import memory
        db = memory.connect()
        spent = memory.spent_today(db)
        # The admin has an ACL granting read here; this fallback covers a host where
        # that was not applied, and degrades one line rather than the whole section.
        limit, limit_note = 50.0, ""
        try:
            for line in LIMITS.read_text().splitlines():
                if line.strip().startswith("DAILY_USD_LIMIT"):
                    limit = float(line.split("=", 1)[1])
        except PermissionError:
            limit_note = " (limit not readable as this user; assuming default)"
        except OSError:
            limit_note = " (no limits file; using built-in default)"
        pct = (spent / limit * 100) if limit else 0
        check("spend today", BAD if pct >= 100 else WARN if pct >= 80 else OK,
              f"${spent:.2f} of ${limit:.2f} ({pct:.0f}%){limit_note}")
        pend = db.execute(
            "SELECT COUNT(*) n FROM messages WHERE delivered_at IS NULL").fetchone()["n"]
        if pend:
            check("held messages", OK, f"{pend} waiting for a player to log in")
    except Exception as e:  # noqa: BLE001
        check("memory", BAD, f"{type(e).__name__}: {e}")

    # --- is it actually doing anything? ------------------------------------
    try:
        age = (time.time() - TRANSCRIPT.stat().st_mtime) / 3600
        check("last log entry", WARN if age > 24 else OK, f"{age:.1f}h ago")
    except OSError:
        check("last log entry", BAD, "no transcript")

    width = max(len(n) for n, _, _ in findings)
    worst = 0
    for name, state, detail in findings:
        mark = {OK: "  ", WARN: " !", BAD: " X"}[state]
        print(f"{mark} {name.ljust(width)}  {detail}")
        worst = max(worst, {OK: 0, WARN: 1, BAD: 2}[state])
    sys.exit(0 if worst == 0 else 1)


if __name__ == "__main__":
    main()
