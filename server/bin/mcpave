#!/usr/bin/env python3
"""mcpave — extend a carriageway.

  mcpave <y> <x1> <z1> <x2> <z2> [--height <n>] [--fill <block>] [options]

  mcpave 62 -3399 239 -3450 243              carry the road on 51 blocks
  mcpave 62 -3399 239 -3450 243 --height 3   ...and pack it for a bore to follow

  <y>                the carriageway level — one below where the markings sit
  --height <n>       make the volume over the new road solid, this high, so that a
                     bore can follow. Off by default; 3 matches mcbore.
  --fill <block>     what to make that volume with       (default minecraft:stone)
  --no-fill          the default, and accepted so older commands still run
  --no-repave        lay the carriageway but leave it unmarked
  --sample <n>       how far to look for intact road to copy      (default 30)
  --dry-run          report what it found, change nothing
  --dimension <dim>  default minecraft:overworld

A tunnel and the road through it are built in that order — road first. mcbore now stops
where the carriageway stops, so extending a road is what lets a tunnel go further, and
doing it by hand means naming the surface block and hoping it is the right one.

Nothing here decides what a road is made of. It finds an intact slice across the road
just beyond the end of the strip and clones it along, so the carriageway comes from a
piece of road that is already correct. Markings are not its business: they sit a level
higher, they are what mcrepave puts back, and a bore is going to clear that level
anyway.

Finding that slice is the part worth being careful about. Solid ground is not road. A
hillside, a beach and a field are every bit as solid and continuous as a carriageway,
and the first version of this tool, asked to carry a road on from the mouth of a
tunnel, took the rock face in front of it for road and offered to clone stone, dirt and
sand the whole way to the coast. A slice counts as road only if it stops at the sides
like a road and repeats along its length like something that was built. Natural ground
fails one test or the other; a beach passes the first and fails the second.

`--height` fills the volume over the new road, and it is off by default because most
paving is not followed by a bore. Water and air read as passable, so a bore scanning
ahead counts them as clear ground and decides it is out the far side — four such steps in
a row end the scan. A road laid across an underground lake would leave a tunnel that
stopped dead at the water, still open to it. Filling that volume first turns the crossing
into ordinary hillside, which is a thing mcbore already knows how to cut and, more to the
point, to line before it cuts. The lining is what keeps the water out afterwards.

That fill was once the default, on the reasoning that paving exists to let a tunnel go
further. Paving mostly does not: asked for 2000 blocks of road across open water, this
laid 538 and sealed every one of them under three layers of stone, because nothing bored
afterwards and nothing was going to. A road you cannot drive on is the wrong result to
reach without being asked. The volume is still scanned on every run, so a run that leaves
water and air in place says how many blocks it left and what a following bore will make
of them.
"""
import subprocess
import sys
from collections import Counter

sys.path.insert(0, "/opt/mc")
import builder  # noqa: E402
import region  # noqa: E402
import roads  # noqa: E402
from mcrcon import Rcon, RconError  # noqa: E402

SAMPLE = 30           # how far to look for an intact slice to copy
SETTLE = 0.6          # seconds for force-loaded chunks to become writable
BORE = 3              # the clearance mcbore cuts, and so the fill height that suits it
WINDOW = 256          # slices paved per force-load, so a long run holds few chunks open

# What a carriageway is and which way it runs lives in roads.py, because mcrepave needs
# the same answers and answering them separately is what let one tool clone a hillside
# and the other clone a tunnel wall.
at = roads.at
slice_names = roads.slice_names
spreads_across = roads.spreads_across
road_slice = roads.road_slice


def find_source(reader, y, lo, hi, acrosses, along_x, reach):
    """The nearest finished slice of road beyond either end of the strip.

    Returns (t, names, side) or None. Both ends are tried because a strip may be an
    extension off one end of a road or a gap punched in the middle of one. The run of
    matching slices is read away from the strip, into road that is certainly finished,
    never back across the part being paved.
    """
    for i in range(1, reach + 1):
        for t, away, side in ((lo - i, -1, "behind"), (hi + i, +1, "ahead")):
            names = road_slice(reader, y, t, away, acrosses, along_x)
            if names:
                return t, names, side
    return None


def main() -> None:
    args = sys.argv[1:]

    def take(flag, cast=str, default=None):
        if flag in args:
            i = args.index(flag)
            value = cast(args[i + 1])
            del args[i:i + 2]
            return value
        return default

    dimension = take("--dimension", str, "minecraft:overworld")
    height = take("--height", int, 0)
    fill = take("--fill", str, "minecraft:stone")
    sample_len = take("--sample", int, SAMPLE)
    no_fill = "--no-fill" in args
    repave = "--no-repave" not in args
    dry = "--dry-run" in args
    nums = [a for a in args if not a.startswith("--")]
    if len(nums) != 5:
        sys.exit(__doc__)
    try:
        y, x1, z1, x2, z2 = (int(v) for v in nums)
    except ValueError:
        sys.exit("all five values must be whole numbers")
    if height < 0:
        sys.exit("--height cannot be negative")
    x1, x2 = sorted((x1, x2))
    z1, z2 = sorted((z1, z2))

    try:
        reader = region.Reader(dimension)
        reader.flush()

        # Which way the road runs comes from the road either side, not from the shape of
        # the strip. Reading the long side as the road holds for a long strip and fails
        # on a short one: a gap of a single block is 1 along and 5 across, so six
        # one-block repairs were attempted at right angles to the carriageway and none
        # of them found any road to copy. Nothing inside the strip can settle it either,
        # because the strip is the damage. So both readings are tried and the one that
        # finds finished road wins; along the road there is some, across it there is not.
        found = along_x = lo = hi = acrosses = None
        for guess in (True, False):
            g_lo, g_hi = (x1, x2) if guess else (z1, z2)
            g_across = list(range(z1, z2 + 1) if guess else range(x1, x2 + 1))
            hit = find_source(reader, y, g_lo, g_hi, g_across, guess, sample_len)
            if hit:
                found, along_x, lo, hi, acrosses = hit, guess, g_lo, g_hi, g_across
                break
        if not found:
            sys.exit(
                f"refusing: no finished road within {sample_len} blocks of either end "
                f"of this strip at y={y}, so there is nothing to say what the "
                f"carriageway should be. A slice counts as road only if it is solid "
                f"right across and no more than {roads.SHOULDER} blocks wider than this "
                f"strip; solid ground that carries on across is a hillside, not a "
                f"road. Check the level — the carriageway is one below the markings — "
                f"and that the strip lines up with the road.")
        src, names, side = found
        kinds = Counter(names)
        print(f"copying the slice at {'x' if along_x else 'z'}={src} "
              f"({side} the strip): "
              f"{', '.join(f'{n.split(chr(58))[-1]}x{c}' for n, c in kinds.items())}")
        print(f"road runs along {'x' if along_x else 'z'}, "
              f"{len(acrosses)} block(s) wide")
        print(f"paving {'x' if along_x else 'z'} {lo}..{hi} at y={y} "
              f"— {(hi - lo + 1) * len(acrosses)} block(s)")

        # The volume over the road is scanned either way. Filling it is what lets a bore
        # cross open water, and leaving it is what makes a road you can drive on, so the
        # same reading either does the work or reports what leaving it will cost.
        filling = bool(height) and not no_fill
        envelope = set()
        for t in range(lo, hi + 1):
            for across in acrosses:
                x, z = at(t, across, along_x)
                for yy in range(y + 1, y + (height if filling else BORE) + 1):
                    if region.passable(reader.block(x, yy, z)):
                        envelope.add((x, yy, z))
        if filling:
            print(f"{len(envelope)} block(s) of water or air over the new road will "
                  f"become {fill}, so a bore can cut and line the crossing")
        else:
            if envelope:
                print(f"{len(envelope)} block(s) over the new road are water or air, and "
                      f"are left alone — that is the road you can drive on. A bore run "
                      f"along here afterwards will read them as open ground and stop at "
                      f"the crossing; pave that stretch again with --height {BORE} first "
                      f"if a tunnel has to follow.")
            envelope = set()

        if dry:
            a1, a2 = acrosses[0], acrosses[-1]
            sx1, sz1 = at(src, a1, along_x)
            print(f"  would clone {sx1} {y} {sz1} .. "
                  f"{at(src, a2, along_x)[0]} {y} {at(src, a2, along_x)[1]} "
                  f"onto each of {hi - lo + 1} slice(s)")
            return

        ctx = f"execute in {dimension} run "
        pad = sample_len + 2
        laid = 0
        a1, a2 = acrosses[0], acrosses[-1]
        sx1, sz1 = at(src, a1, along_x)
        sx2, sz2 = at(src, a2, along_x)
        # The slice being copied from has to stay loaded for every window, not only for
        # whichever one it happens to sit beside.
        src_box = (min(sx1, sx2) - pad, min(sz1, sz2) - pad,
                   max(sx1, sx2) + pad, max(sz1, sz2) + pad)
        with Rcon() as rcon:
            import time
            for start in range(lo, hi + 1, WINDOW):
                stop = min(start + WINDOW - 1, hi)
                wx1, wz1 = at(start, a1, along_x)
                wx2, wz2 = at(stop, a2, along_x)
                box = (min(wx1, wx2) - pad, min(wz1, wz2) - pad,
                       max(wx1, wx2) + pad, max(wz1, wz2) + pad)
                builder.forceload(rcon, ctx, box, add=True)
                builder.forceload(rcon, ctx, src_box, add=True)
                try:
                    time.sleep(SETTLE)
                    for t in range(start, stop + 1):
                        dx1, dz1 = at(t, a1, along_x)
                        # clone, not fill: the carriageway comes across exactly as it
                        # is, kerbs, block states and all, without anything here
                        # naming it.
                        out = rcon.command(f"{ctx}clone {sx1} {y} {sz1} "
                                           f"{sx2} {y} {sz2} {dx1} {y} {dz1}")
                        if "cloned" in out.lower():
                            laid += 1
                finally:
                    builder.forceload(rcon, ctx, box, add=False)
            builder.forceload(rcon, ctx, src_box, add=False)
        print(f"laid {laid} of {hi - lo + 1} slice(s)")

        if envelope:
            with Rcon() as rcon:
                changed = builder.write(rcon, dimension, envelope, fill)
            print(f"filled {changed} block(s) over the new road with {fill}")

        if laid < hi - lo + 1:
            sys.exit(f"{hi - lo + 1 - laid} slice(s) would not take the clone. The road "
                     f"is part laid; re-run once you know why.")

        # A road without its markings is not a finished road, and laying them is a
        # thing mcrepave already does correctly: it reads the repeat off the road
        # behind, matches the phase, and clones a marking that is already the right way
        # round. Extending the carriageway and leaving the markings to a separate
        # request produced 2,538 blocks of blank asphalt.
        if repave:
            out = subprocess.run(
                ["/opt/mc/mcrepave", str(y + 1), str(x1), str(z1), str(x2), str(z2),
                 "--dimension", dimension],
                capture_output=True, text=True)
            for line in (out.stdout + out.stderr).splitlines():
                print(f"  {line}")
            if out.returncode != 0:
                sys.exit("the carriageway is laid but the markings are not. Fix the "
                         "reason above and re-run mcrepave over the same strip; "
                         "paving again is not needed.")

    except region.RegionError as e:
        sys.exit(str(e))
    except ValueError as e:
        sys.exit(str(e))
    except RconError as e:
        sys.exit(f"rcon failed: {e}")


if __name__ == "__main__":
    main()
