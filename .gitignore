# Secrets — never commit
*.key
*.pass
*.env
env
api.key
.mc-api-key
id_ed25519*

# Runtime state
logs/
*.log
*.jsonl
.venv/
venv/
__pycache__/
*.pyc

# World data / backups / large artefacts
*.tar.gz
*.zip
*.nbt
*.dat

# World-specific prompt additions stay local
server/mcbot/local-lore.md

# Personas that stay local — quoted material, private voices.
# A pattern, not a filename: a voice keeps supporting files beside it (the lines it
# was tuned against), and each new one would otherwise need remembering here.
server/personas/frank*
server/personas/*.local.md

# Personal project rules — preferences and operational notes, not shared
CLAUDE.local.md

# Project working notes — dated state, not product documentation
notes/
